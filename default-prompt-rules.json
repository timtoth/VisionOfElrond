{
  "defaultsVersion": 2,
  "rules": [
    {
      "id": "aragorn-rally-scout",
      "description": "Aragorn: in the rally phase, heroes adjacent to him scout 1 more than the app says.",
      "enabled": true,
      "when": {
        "heroesInParty": [
          "Aragorn"
        ],
        "textMatches": "\\breset\\w* (?:your|their|his|her) decks?\\b[\\s\\S]{0,80}?\\bscouts? (\\d+)"
      },
      "append": "Heroes adjacent to Aragorn: [b]Scout +1[/b] (scout {1+1})."
    },
    {
      "id": "terrain-barrels",
      "description": "When the app asks to place Barrels, remind what it does.",
      "enabled": true,
      "when": {
        "keys": [
          "UI_TERRAIN_NODES_REVEAL_FORMATTED"
        ],
        "textMatches": "(?m)^\\s*\\d+ (?:Barrel|Barrels)\\s*$"
      },
      "append": "{key:TERRAIN_NODE_INFO_BARRELS}"
    },
    {
      "id": "terrain-barricade",
